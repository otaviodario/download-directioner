{
  "manifest_version": 3,
  "name": "Download Directioner",
  "version": "1.0.2",
  "description": "Automatically route downloads to custom subfolders based on file types, names, MIME types, or website origins.",
  "icons": {
    "16": "icons/logo.png",
    "32": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/logo.png",
      "32": "icons/logo.png",
      "48": "icons/logo.png",
      "128": "icons/logo.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module",
    "scripts": ["background/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "download-directioner@extension.local"
    }
  }
}